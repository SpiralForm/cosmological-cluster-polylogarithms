                    RowBox[{"LegendreP", "[", 
                    RowBox[{"len", ",", " ", "x"}], "]"}], ",", " ", "x"}], 
                    "]"}], " ", "/.", " ", 
                    RowBox[{"x", " ", "->", " ", "#"}]}], ")"}], "&"}], " ", "/@",
                   " ", "z"}], ")"}], "^", "2"}], ")"}]}], ")"}]}], "]"}]}], ";",
          "\n", "   ", 
         RowBox[{"z", " ", "=", " ", 
          RowBox[{"N", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "+", "z"}], ")"}], "/", "2"}], "]"}]}], ";", "\n", 
         "   ", 
         RowBox[{"{", 
          RowBox[{"len", ",", " ", 
           RowBox[{
            RowBox[{"With", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"expr", " ", "=", " ", "expr"}], "}"}], ",", "\n", 
              "     ", 
              RowBox[{"Compile", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"z", ",", " ", "_Real", ",", " ", "1"}], "}"}], ",",
                   " ", 
                  RowBox[{"{", 
                   RowBox[{"omega", ",", " ", "_Real", ",", " ", "1"}], 
                   "}"}]}], "}"}], ",", "\n", "      ", 
                RowBox[{"Module", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"numer", " ", "=", " ", "0."}], "}"}], ",", "\n", 
                  "       ", 
                  RowBox[{
                   RowBox[{"Do", "[", 
                    RowBox[{
                    RowBox[{"numer", " ", "+=", " ", 
                    RowBox[{
                    RowBox[{"omega", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], " ", 
                    RowBox[{"omega", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], " ", "*", "\n", 
                    "         ", 
                    RowBox[{"expr", "[", 
                    RowBox[{
                    RowBox[{"z", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], ",", " ", 
                    RowBox[{"z", "[", 
                    RowBox[{"[", "j", "]"}], "]"}]}], "]"}]}]}], ",", "\n", 
                    "        ", 
                    RowBox[{"{", 
                    RowBox[{"i", ",", " ", 
                    RowBox[{"Length", "[", "z", "]"}]}], "}"}], ",", " ", 
                    RowBox[{"{", 
                    RowBox[{"j", ",", " ", 
                    RowBox[{"Length", "[", "z", "]"}]}], "}"}]}], "]"}], ";", 
                   "\n", "       ", "numer"}]}], "]"}], ",", "\n", "      ", 
                RowBox[{"CompilationOptions", " ", "->", " ", 
                 RowBox[{"{", 
                  
                  RowBox[{"\"\<InlineCompiledFunctions\>\"", " ", "->", " ", 
                   "True"}], "}"}]}]}], "]"}]}], "\n", "    ", "]"}], "[", 
            RowBox[{"z", ",", " ", "omega"}], "]"}]}], "}"}]}], ",", "\n", 
        "   ", 
        RowBox[{"{", 
         RowBox[{"len", ",", " ", 
          RowBox[{"{", 
           RowBox[{"20", ",", " ", "40", ",", " ", "80"}], "}"}]}], "}"}]}], 
       "]"}], ",", "\n", "  ", "17"}], "]"}]}]}], "\n", "]"}]], "Input",
 CellLabel->"In[14]:=",ExpressionUUID->"770836f5-ac24-4b8f-93a6-dd4bdc736ab3"],

