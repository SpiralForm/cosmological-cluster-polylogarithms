      RowBox[{
       RowBox[{"{", 
        RowBox[{"z", ",", " ", "Subscript"}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{
         RowBox[{"Subscript", "[", 
          RowBox[{"z", ",", " ", "i_Integer"}], "]"}], " ", ":=", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
             "0", ",", "16", ",", "14", ",", "30", ",", "26", ",", "48", ",", 
              "42", ",", "68"}], "}"}], "/", "60"}], ")"}], "[", 
          RowBox[{"[", "i", "]"}], "]"}]}], ";", "\n", "   ", 
        RowBox[{
         RowBox[{"Subscript", "[", 
          RowBox[{"z", ",", " ", 
           RowBox[{"bar", "[", "i_Integer", "]"}]}], "]"}], " ", ":=", " ", 
         RowBox[{"1", " ", "+", " ", 
          RowBox[{"Subscript", "[", 
           RowBox[{"z", ",", " ", "i"}], "]"}]}]}], ";", "\n", "   ", 
        RowBox[{"TarpB", "[", "4", "]"}]}]}], "\n", " ", "]"}]}], ";", "\n", 
    " ", 
    RowBox[{"expr", " ", "=", " ", 
     RowBox[{"expr", " ", "/.", " ", 
      RowBox[{
       RowBox[{"HoldPattern", "[", 
        RowBox[{"ab", "[", "omega__", "]"}], "]"}], " ", ":>", " ", 
       RowBox[{"Li", "[", 
        RowBox[{"ab", "[", "omega", "]"}], "]"}]}]}]}], ";", "\n", " ", 
    RowBox[{"Chop", "[", 
