Cell[CellGroupData[{

Cell["Direct energy integral: numerical evaluation", "Subsubsection",ExpressionUUID->"0e95b1ed-84cf-4bdd-896d-5def70f10fe6"],

Cell["\<\
First define the explicit rational integrand. The next cell maps the positive \
orthant to the unit cube, includes the Jacobian, and applies tensor-product \
Gauss-Legendre quadrature. Each output pair is {nodes per variable, direct \
integral}. All numerical integration is performed by Mathematica; no external \
compiler is required.\
\>", "Text",ExpressionUUID->"0e3bda02-c08d-4793-8729-c8408bf9eccc"],

Cell[BoxData[
 RowBox[{
  RowBox[{"expr", " ", "=", " ", 
   RowBox[{
    RowBox[{"8", "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"x", "[", "1", "]"}], "+", "8"}], ")"}], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"x", "[", "2", "]"}], "+", "10"}], ")"}], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"x", "[", "1", "]"}], "+", 
         RowBox[{"x", "[", "2", "]"}], "+", "12"}], ")"}]}], ")"}]}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"1", "/", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"x", "[", "1", "]"}], "+", 
         RowBox[{"x", "[", "2", "]"}], "+", "14"}], ")"}]}], "+", "\n", " ", 
      RowBox[{"1", "/", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"x", "[", "1", "]"}], "+", 
         RowBox[{"x", "[", "2", "]"}], "+", "16"}], ")"}]}]}], ")"}]}]}], 
  ";"}]], "Input",
 CellLabel->"In[13]:=",ExpressionUUID->"f47d197f-e8d2-453f-acaf-a2e334c5e4c1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"expr", " ", "=", " ", "expr"}], ",", " ", "z", ",", " ", 
     "omega", ",", " ", "x1", ",", " ", "x2"}], "}"}], ",", "\n", " ", 
   RowBox[{
    RowBox[{"expr", " ", "=", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"expr", " ", "/.", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"x", "[", "1", "]"}], " ", "->", " ", 
           RowBox[{"5", " ", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"x1", "/", 
               RowBox[{"(", 
                RowBox[{"1", "-", "x1"}], ")"}]}], ")"}], "^", "2"}]}]}], ",",
           "\n", "   ", 
          RowBox[{
           RowBox[{"x", "[", "2", "]"}], " ", "->", " ", 
           RowBox[{"7", " ", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"x2", "/", 
               RowBox[{"(", 
                RowBox[{"1", "-", "x2"}], ")"}]}], ")"}], "^", "2"}]}]}]}], 
         "}"}]}], ")"}], " ", "*", "\n", "   ", "140", " ", "x1", " ", 
      RowBox[{"x2", "/", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "-", "x1"}], ")"}], " ", 
          RowBox[{"(", 
           RowBox[{"1", "-", "x2"}], ")"}]}], ")"}], "^", "3"}]}]}]}], ";", 
    "\n", " ", 
    RowBox[{"expr", " ", "=", " ", 
     RowBox[{"Compile", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x1", ",", " ", "_Real"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"x2", ",", " ", "_Real"}], "}"}]}], "}"}], ",", " ", 
       RowBox[{"Evaluate", "[", "expr", "]"}]}], "]"}]}], ";", "\n", " ", 
    RowBox[{"NumberForm", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"Table", "[", "\n", "   ", 
       RowBox[{
        RowBox[{
         RowBox[{"z", " ", "=", " ", 
          RowBox[{"Sort", "[", 
           RowBox[{"x", " ", "/.", " ", 
            RowBox[{"NSolve", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"LegendreP", "[", 
                RowBox[{"len", ",", " ", "x"}], "]"}], " ", "==", " ", "0"}], 
              ",", " ", "x", ",", " ", 
              RowBox[{"WorkingPrecision", " ", "->", " ", "40"}]}], "]"}]}], 
           "]"}]}], ";", "\n", "   ", 
         RowBox[{"omega", " ", "=", " ", 
          RowBox[{"N", "[", 
           RowBox[{"1", "/", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"1", "-", 
                RowBox[{"z", "^", "2"}]}], ")"}], " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"(", 
