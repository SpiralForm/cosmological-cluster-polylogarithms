Notebook[{
Cell["Ancillary code for \"de Sitter Wavefunction from Quadrangular \
Polylogarithms: loops\".", "Text", ExpressionUUID -> 
    "4569b326-2d7b-4ab2-b8cb-77f314f15f93"],

Cell[CellGroupData[{

Cell["B-type quadrangular polylogarithms", "Section", 
      ExpressionUUID -> "9372e26c-bb63-49d7-9e9e-9dc853511f30"],

Cell["QLiB denotes the B-type quadrangular polylogarithm of Section 3. \
Only the root-last ordering is included. The multiple polylogarithms use the \
increasing convention 0 < n1 < ... < nd and are left symbolic. All \
definitions are in the accompanying QLiB.m. Load it below before evaluating \
the examples.", "Text", ExpressionUUID -> 
       "b8593db5-da8b-42f3-b0d5-b8e462f78c89"],

Cell["QLiB[n] uses the \
polygon {1,...,2n,bar[1],...,bar[2n]}. QLiB[mypg] accepts the full \
alternating, centrally symmetric list of integer vertex labels; bar[i] has \
the parity of i. The weight is fixed by the length of this list. \
Subscript[z,i] denotes the coordinate attached to vertex i.", "Text", 
      ExpressionUUID -> "ce9af4fb-d900-4739-b28f-d3e0664bb896"],

Cell[CellGroupData[{

Cell["Load QLiB.m", "Subsection", 
         ExpressionUUID -> "d3cd9329-48f8-4d5d-9cec-c3bc7f9fc21c"],

Cell["Keep QLiB.m in the same directory as this notebook and evaluate \
the following cell before the examples. QLip is built from Tarp; QLiB is \
built from TarpB. The original chain QLi is not required.", "Text", 
         ExpressionUUID -> "8c940c1d-7790-4ffa-9215-71f1de18a9fa"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Get", "[", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"NotebookDirectory", "[", "]"}], ",", "\"\<QLiB.m\>\""}], "}"}],
     "]"}], "]"}], ";"}], "\[IndentingNewLine]", 
