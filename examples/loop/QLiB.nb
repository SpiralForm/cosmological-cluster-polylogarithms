Cell["QLiB: numerical evaluation", "Subsubsection",ExpressionUUID->"6836bf3c-a927-45f9-9aee-b884d5f8004d"],

Cell["\<\
Apply Li to the weighted words of TarpB term by term; this is QLiB with the \
same definition and ordering. Reverse both MPL lists when calling numLi.\
\>", "Text",ExpressionUUID->"ae7f98df-4acc-40fe-83c8-e6a18c759706"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", "expr", "}"}], ",", "\n", " ", 
   RowBox[{
    RowBox[{"expr", " ", "=", " ", 
     RowBox[{"Block", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"z", ",", " ", "Subscript"}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{
         RowBox[{"Subscript", "[", 
          RowBox[{"z", ",", " ", "i_Integer"}], "]"}], " ", ":=", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"{", 
            RowBox[{"0", ",", 
             RowBox[{"2", "/", "3"}], ",", 
             RowBox[{"1", "/", "2"}], ",", 
             RowBox[{"4", "/", "3"}]}], "}"}], ")"}], "[", 
          RowBox[{"[", "i", "]"}], "]"}]}], ";", "\n", "   ", 
        RowBox[{
         RowBox[{"Subscript", "[", 
          RowBox[{"z", ",", " ", 
           RowBox[{"bar", "[", "i_Integer", "]"}]}], "]"}], " ", ":=", " ", 
         RowBox[{"1", " ", "+", " ", 
          RowBox[{"Subscript", "[", 
           RowBox[{"z", ",", " ", "i"}], "]"}]}]}], ";", "\n", "   ", 
        RowBox[{"TarpB", "[", "2", "]"}]}]}], "\n", " ", "]"}]}], ";", "\n", 
    " ", 
    RowBox[{"expr", " ", "=", " ", 
     RowBox[{"expr", " ", "/.", " ", 
      RowBox[{
       RowBox[{"HoldPattern", "[", 
        RowBox[{"ab", "[", "omega__", "]"}], "]"}], " ", ":>", " ", 
       RowBox[{"Li", "[", 
        RowBox[{"ab", "[", "omega", "]"}], "]"}]}]}]}], ";", "\n", " ", 
    RowBox[{"Chop", "[", 
     RowBox[{
      RowBox[{"expr", " ", "/.", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Subscript", "[", 
          RowBox[{"Li", ",", " ", "m__"}], "]"}], "[", "var__", "]"}], " ", ":>",
         "\n", "   ", 
        RowBox[{"numLi", "[", 
         RowBox[{
          RowBox[{"Reverse", "[", 
           RowBox[{"{", "m", "}"}], "]"}], ",", " ", 
          RowBox[{"Reverse", "[", 
           RowBox[{"{", "var", "}"}], "]"}], ",", " ", "35"}], "]"}]}]}], ",",
       " ", 
      RowBox[{"10", "^", 
       RowBox[{"-", "30"}]}]}], "]"}]}]}], "\n", "]"}]], "Input",
