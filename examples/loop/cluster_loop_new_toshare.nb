Cell[TextData[{
 "the new way for constructing arborification and QLi. This should produce \
the full symbol of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Psi]", "4"], TraditionalForm]],ExpressionUUID->
  "70f963a3-18cd-4544-9e5d-bca57cd4c93a"],
 " without mod product by one single QLiB!"
}], "Text",
